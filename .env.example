# Copy to .env to override the defaults in docker-compose.yml.

POSTGRES_USER=trades
POSTGRES_PASSWORD=trades
POSTGRES_DB=trades

# Live prices. Create a free account at https://finnhub.io, copy the API key
# from the dashboard and paste it here. Leave empty to run without live prices.
FINNHUB_API_KEY=
# How many seconds a fetched price is reused before asking Finnhub again.
PRICE_TTL_SECONDS=60

# Whether new accounts can be created. Existing accounts work either way.
SIGN_UP_OPEN=true
# How many days a browser or the app stays signed in after it was last used.
SESSION_DAYS=90

# Email: the codes that confirm an address and reset a password. "log" writes
# them into the server log (docker compose logs web) instead of sending them.
# To send them with Resend, see "Email" in the README.
MAIL_BACKEND=log
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# Network interface the web app is published on. The default only accepts
# connections from this machine. Use 0.0.0.0 to reach it from other devices.
BIND_ADDRESS=127.0.0.1
# Behind a reverse proxy on this machine (see "Hosting" in the README), set to *
# so the app sees visitors' addresses and knows the page came over HTTPS.
FORWARDED_ALLOW_IPS=127.0.0.1
